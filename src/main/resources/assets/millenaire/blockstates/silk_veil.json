{
  "multipart": [
    {
      "apply": {
        "model": "millenaire:block/silk_veil_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "millenaire:block/silk_veil_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "millenaire:block/silk_veil_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "millenaire:block/silk_veil_side_alt"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "millenaire:block/silk_veil_side_alt",
        "y": 90
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "millenaire:block/silk_veil_noside"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "millenaire:block/silk_veil_noside_alt"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "millenaire:block/silk_veil_noside_alt",
        "y": 90
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "millenaire:block/silk_veil_noside",
        "y": 270
      }
    }
  ]
}
